<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="PatternMapper">

    <!-- 기준정보 > 패턴관리 (base_pattern) -->

    <select id="selectList" parameterType="map" resultType="com.mes.domain.base.Pattern">
        SELECT id, use_yn, reg_dt, upd_dt
        FROM base_pattern
        <where>
            <if test="keyword != null and keyword != ''">
                AND id LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="selectCount" parameterType="map" resultType="long">
        SELECT COUNT(*)
        FROM base_pattern
        <where>
            <if test="keyword != null and keyword != ''">
                AND id LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
    </select>

</mapper>
